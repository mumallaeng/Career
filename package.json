{
  "name": "yeonwoofolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "npm run sync:onedrive && npm run audit:media && du -sh public/import-data",
    "build": "next build",
    "build:local": "SKIP_ONEDRIVE_SYNC=1 npm run build",
    "build:turbo": "next build --turbopack",
    "export": "next build && next export",
    "start": "next start",
    "lint": "eslint",
    "validate:publication": "tsx scripts/validate-publication.ts",
    "audit:media": "tsx scripts/audit-media-delivery.ts",
    "validate:local": "npm run validate:publication && npm run lint && npm run build:local",
    "sync:onedrive": "tsx scripts/sync-onedrive.ts",
    "derive:onedrive": "ONEDRIVE_COMPARE_REMOTE=1 tsx scripts/build-onedrive-derivatives.ts && npm run optimize:videos",
    "optimize:videos": "tsx scripts/optimize-onedrive-videos.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.0.1",
    "@types/mdx": "^2.0.13",
    "@vercel/analytics": "^1.5.0",
    "deepmerge-ts": "^7.1.5",
    "next": "^15.5.7",
    "next-mdx-remote": "^6.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.7",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "overrides": {
    "mdast-util-to-hast": "13.2.1"
  }
}
